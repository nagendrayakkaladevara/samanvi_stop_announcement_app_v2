{
  "cli": { "version": ">= 18.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": { "EXPO_PUBLIC_API_BASE_URL": "https://samanvi-ticketing-tool-backend.vercel.app/api/v1" }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": { "EXPO_PUBLIC_API_BASE_URL": "https://samanvi-ticketing-tool-backend.vercel.app/api/v1" },
      "android": { "buildType": "apk" }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": { "EXPO_PUBLIC_API_BASE_URL": "https://samanvi-ticketing-tool-backend.vercel.app/api/v1" }
    }
  }
}
