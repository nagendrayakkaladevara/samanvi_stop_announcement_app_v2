{
  "expo": {
    "name": "Samanvi Driver",
    "slug": "samanvi-driver-mobile",
    "version": "2.1.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.samanvitravels.driver.v2"
    },
    "android": {
      "package": "com.samanvitravels.driver.v2",
      "softwareKeyboardLayoutMode": "resize",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Samanvi Driver"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F5F7",
          "image": "./assets/app-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "dark": { "backgroundColor": "#111315", "image": "./assets/app-icon.png" }
        }
      ],
      "expo-secure-store",
      "expo-font"
    ],
    "scheme": "samanvi-driver-v2",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5e55e14d-d0b3-4158-9e38-372e665e41c5"
      }
    }
  }
}
